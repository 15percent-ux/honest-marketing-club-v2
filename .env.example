# ===== Zoom予約自動化に必要な環境変数 =====
# ローカル開発では `netlify dev` 実行時に .env として読み込まれます。
# 本番は Netlify ダッシュボード > Site configuration > Environment variables に設定してください。
# 詳しい取得手順は docs/ZOOM_BOOKING_SETUP.md を参照。

# --- Zoom (Server-to-Server OAuth アプリ / 有料アカウント millefield@gmail.com) ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Google (カレンダー登録 + Gmail送信 / millefield@gmail.com) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- 任意設定（未設定ならデフォルト値） ---
# HOST_EMAIL=millefield@gmail.com
# HOST_NAME=Honest Marketing Club
# BOOKING_CALENDAR_ID=primary
# BOOKING_SLOT_MINUTES=60
# BOOKING_START_HOUR=10
# BOOKING_END_HOUR=18
# BOOKING_DAYS_AHEAD=14
# BOOKING_MIN_NOTICE_HOURS=12
# BOOKING_MEETING_TITLE=無料相談（Honest Marketing Club）

# --- 既存 ---
GEMINI_API_KEY=
